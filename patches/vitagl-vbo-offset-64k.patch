+// SceGxmVertexAttribute::offset is only 16 bits wide, but vertex_attrib_offsets[]
+// is a uint32_t and an app may legitimately draw from deep inside a large VBO
+// (packing many meshes into one buffer and pointing each draw at its own slice).
+// Assigning such an offset straight through silently truncates it mod 64 KB, so
+// the GPU fetches every attribute from the wrong vertex.
+// Rebase in that case: find the lowest enabled attribute offset, fold it into the
+// stream pointer, and store only the (small) intra-vertex remainder. Draws whose
+// offsets already fit are left byte-for-byte as before.
+#define compute_packed_vbo_base() \
+	uint32_t vbo_off_base = 0, vbo_off_max = 0, vbo_off_min = 0xFFFFFFFF; \
+	for (int i = 0; i < p->attr_num; i++) { \
+		uint8_t attr_idx = p->attr_map[i]; \
+		if (cur_vao->vertex_attrib_state & (1 << attr_idx)) { \
+			uint32_t o = cur_vao->vertex_attrib_offsets[attr_idx]; \
+			if (o > vbo_off_max) vbo_off_max = o; \
+			if (o < vbo_off_min) vbo_off_min = o; \
+		} \
+	} \
+	if (vbo_off_max > 0xFFFF) vbo_off_base = vbo_off_min;
+
 #define handle_packed_vbo_attrib() \
 	if (cur_vao->vertex_attrib_state & (1 << attr_idx)) { \
-		attributes[i].offset = cur_vao->vertex_attrib_offsets[attr_idx]; \
+		attributes[i].offset = cur_vao->vertex_attrib_offsets[attr_idx] - vbo_off_base; \
 	} else { \
 		disable_draw_attrib(i) \
-	}	
+	}
+
+// The client-array twin of compute_packed_vbo_base(). attr_map[i] == i, so
+// attr_map[0] is attribute location 0 -- which is NOT necessarily the attribute
+// sitting lowest in the vertex. KOTOR's skinned layout is the counter-example:
+//   loc 2 a_position      +0x00   <- lowest in the vertex
+//   loc 3 a_normal        +0x0c
+//   loc 4 a_texCoord0     +0x18
+//   loc 0 a_matrixWeights +0x20   <- attr_map[0]
+//   loc 1 a_matrixIndices +0x30
+// Basing on attr_map[0] then subtracts a LARGER offset from a smaller one:
+// a_position gets 0x00 - 0x20 = 0xFFFFFFE0, which lands in a uint16 offset
+// field as 65504, and the GPU fetches positions from 64 KB into the stream.
+// The memcpy is wrong in the same way -- it starts at attr_map[0]'s address, so
+// the position bytes, which live *before* it, are never copied at all.
+// Base on the lowest enabled offset instead. When attr_map[0] already is the
+// lowest -- every non-skinned layout here -- min equals it and nothing changes.
+#define compute_packed_cli_base() \
+	uint32_t cli_off_base = cur_vao->vertex_attrib_offsets[p->attr_map[0]]; \
+	for (int i = 0; i < p->attr_num; i++) { \
+		uint8_t attr_idx = p->attr_map[i]; \
+		if (cur_vao->vertex_attrib_state & (1 << attr_idx)) { \
+			uint32_t o = cur_vao->vertex_attrib_offsets[attr_idx]; \
+			if (o < cli_off_base) cli_off_base = o; \
+		} \
+	}
 
 #define handle_packed_attrib() \
 	if (cur_vao->vertex_attrib_state & (1 << attr_idx)) { \
-		attributes[i].offset = cur_vao->vertex_attrib_offsets[attr_idx] - cur_vao->vertex_attrib_offsets[p->attr_map[0]]; \
+		attributes[i].offset = cur_vao->vertex_attrib_offsets[attr_idx] - cli_off_base; \
 	} else { \
 		disable_draw_attrib(i) \
 	}
